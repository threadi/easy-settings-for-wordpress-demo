                "cancel_button_title": "Cancel",
                "chosen_title": "Choose a page",
                "popup_title": "Choose a page",
                "popup_description": "Please choose a post type you want to set in the settings.",
                "endpoint": "/wp-json/wp/v2/pages"
              }
            },
            {
              "name": "esfw_json_demo_text",
              "type": "string",
              "default": "",
              "field": {
                "type": "Text",
                "title": "Text",
                "description": "This allows you to add a simple text in the settings.",
                "placeholder": "This is a placeholder"
              }
            },
            {
              "name": "esfw_json_demo_textarea",
              "type": "string",
              "default": "",
              "field": {
                "type": "Textarea",
                "title": "Textarea",
                "description": "This allows you to add a multiline text in the settings.",
                "placeholder": "This is a placeholder"
              }
            },
            {
              "name": "esfw_json_demo_textinfo",
              "field": {
                "type": "TextInfo",
                "title": "TextInfo",
                "description": "This allows you to show a simple text info between the settings. This text here is such a text."
              }
            },
            {
              "name": "esfw_json_demo_value",
              "field": {
                "type": "Value",
                "title": "Value",
                "description": "This allows you to show the value of this setting without any change to change it.",
                "value": "Hallo World"
              }
            }
          ]
        }
      ]
    },
    {
