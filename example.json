{
  "slug": "demo_settings_json",
  "title": "Demo Settings via JSON",
  "menu_title": "Demo Settings JSON",
  "menu_slug": "demo-settings-json",
  "capability": "manage_options",
  "auto_save": "change",
  "show_settings_link_in_plugin_list": true,
  "default_tab": "demo_basic_json",
  "tabs": [
    {
      "name": "demo_basic_json",
      "title": "The fields",
      "description": "<p>These tab presents the simple fields the composer package \"Easy Settings for WordPress\" support.</p>",
      "position": 10,
      "sections": [
        {
          "name": "first_section",
          "title": "Examples for all supported fields",
          "settings": [
            {
              "name": "esfw_json_demo_button",
              "field": {
                "type": "Button",
                "title": "Button",
                "description": "This is a button. It does not save any value as setting but could be used start an action.",
                "button_url": "#",
                "button_title": "Click me",
                "data": {
                  "dialog": "{\"title\":\"You clicked me!\",\"texts\":[\"<p></p>\"],\"buttons\":[{\"action\":\"closeDialog();\",\"variant\":\"primary\",\"text\":\"Close\"}]}"
                },
                "classes": [
                  "easy-dialog-for-wordpress"
                ]
              }
            },
            {
              "name": "esfw_json_demo_checkbox",
              "type": "integer",
              "default": 0,
              "field": {
                "type": "Checkbox",
                "title": "Checkbox",
                "description": "This is a checkbox. It could be used to enable or disable things."
              }
            },
            {
              "name": "esfw_json_demo_checkboxes",
              "type": "array",
              "default": {
                "second": 1
              },
              "field": {
                "type": "Checkboxes",
                "title": "Checkboxes",
                "description": "These are multiple checkboxes. It could be used to enable or disable multiple things.",
                "options": {
                  "first": {
                    "label": "First"
                  },
                  "second": {
                    "label": "Second"
                  },
                  "third": {
                    "label": "Third"
                  }
                }
              }
            },
            {
              "name": "esfw_json_demo_file",
              "type": "string",
              "default": "",
              "field": {
                "type": "File",
                "title": "File",
                "description": "This allows you to select an image file from your media library, which will be saved in the settings.",
                "add_file_title": "Add an image",
                "remove_file_title": "Remove image"
              }
            },
            {
              "name": "esfw_json_demo_files",
              "type": "array",
              "default": [],
              "field": {
                "type": "Files",
                "title": "Files",
                "description": "This allows you to select images from your media library, which will be saved in the settings."
              }
            },
            {
              "name": "esfw_json_demo_multiselect",
              "type": "array",
              "default": [
                "second"
              ],
              "field": {
                "type": "MultiSelect",
                "title": "Multiple values",
                "description": "This allows you to choose multiple values from a list.",
                "options": {
                  "first": "First",
                  "second": "Second",
                  "third": "Third"
                }
              }
            },
            {
              "name": "esfw_json_demo_number",
              "type": "integer",
              "default": 0,
              "field": {
                "type": "Number",
                "title": "Number",
                "description": "This allows you to set a number in the settings."
              }
            },
            {
              "name": "esfw_json_demo_password",
              "type": "string",
              "default": "",
              "field": {
                "type": "Password",
                "title": "Password",
                "description": "This allows you to set a hidden password in the settings."
              }
            },
            {
              "name": "esfw_json_demo_permalink_slug",
              "type": "string",
              "default": "",
              "field": {
                "type": "PermalinkSlug",
                "title": "Permalink Slug",
                "description": "This allows you to set a permalink slug in the settings.",
                "options": {
                  "first": "First",
                  "second": "Second",
                  "third": "Third"
                },
                "list_title": "Choose params"
              }
            },
            {
              "name": "esfw_json_demo_radio",
              "type": "string",
              "default": "first",
              "field": {
                "type": "Radio",
                "title": "Radio",
                "description": "This allows you to show a set of possible options for a single setting.",
                "options": {
                  "first": "First",
                  "second": "Second",
                  "third": "Third"
                }
              }
            },
            {
              "name": "esfw_json_demo_select",
              "type": "string",
              "default": "first",
              "field": {
                "type": "Select",
                "title": "Select",
                "description": "This allows you to show a set of possible options for a single setting.",
                "options": {
                  "first": "First",
                  "second": "Second",
                  "third": "Third"
                }
              }
            },
            {
              "name": "esfw_json_demo_select_post_type",
              "type": "string",
              "default": "",
              "field": {
                "type": "SelectPostTypeObject",
                "title": "Select a post type object",
                "description": "This allows you to choose a post type object like a page or a post. We show here how to select a page.",
