                "button_title": "Export now",
                "classes": [
                  "easy-dialog-for-wordpress"
                ],
                "data": {
                  "dialog": "{\"title\":\"Export settings\",\"texts\":[\"<p><strong>Click on the following button to download the settings as JSON-file.</strong></p>\",\"<p>You can import this JSON-file in other projects using this WordPress plugin or theme.</p>\"],\"buttons\":[{\"action\":\"closeDialog();location.href=\\\"DOWNLOAD_URL\\\";\",\"variant\":\"primary\",\"text\":\"Export now\"},{\"action\":\"closeDialog();\",\"variant\":\"secondary\",\"text\":\"Cancel\"}]}"
