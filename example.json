            {
              "name": "import_settings_json",
              "prevent_export": true,
              "show_in_rest": false,
              "autoload": false,
              "field": {
                "type": "Button",
                "title": "Import",
                "button_title": "Import now",
                "classes": [
                   "easy-dialog-for-wordpress"
                 ],
                "data": {
                  "dialog": "{\"title\":\"Import settings\",\"texts\":[\"<p><strong>Choose the JSON-file with the settings.</strong></p>\",\"<input type=\\\"file\\\" accept=\\\"application/json\\\" name=\\\"import_settings_file\\\" id=\\\"import_settings_file\\\">\"],\"buttons\":[{\"action\":\"esefw_settings_import_file();\",\"variant\":\"primary\",\"text\":\"Import now\"},{\"action\":\"closeDialog();\",\"variant\":\"secondary\",\"text\":\"Cancel\"}]}"
                }
              }
            },
            {
              "name": "export_settings_json",
              "prevent_export": true,
              "show_in_rest": false,
              "autoload": false,
              "field": {
