msgstr "Jetzt importieren"

#: settings.php:507
msgid "Import"
msgstr "Importieren"

#: settings.php:515
msgid "Export settings"
msgstr "Einstellungen exportieren"

#: settings.php:517
msgid "Click on the following button to download the settings as JSON-file."
msgstr ""
"Klicke auf die folgende Schaltfläche, um die Einstellungen als JSON-Datei "
"herunterzuladen."

#: settings.php:518
msgid ""
"You can import this JSON-file in other projects using this WordPress plugin "
